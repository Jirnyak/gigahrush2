# Судья ПОЛНОТЫ контура строки мира.
#
# РАЗДЕЛЕНИЕ ТРУДА, А НЕ ВТОРОЙ ЛИНТЕР
# ------------------------------------
# ЗАКОН судит КОМПИЛЯТОР: структура, в которую заложили вектор, строку, карту,
# умный указатель или виртуальный метод, НЕ СОБИРАЕТСЯ, и сообщение называет
# виноватый род члена поимённо (`GIGA_ROW@src/core/row_law.h`). Замерено
# мутацией 2026-10-01: `std::vector`, `std::string`, `std::unique_ptr` и
# `std::map` членом валят по ДВА асёрта контура, `virtual` — ТРИ, чистая строка
# собирается, а пришитое служебное поле ловится `GIGA_ROW_BYTES` через sizeof.
#
# У этой стены ровно одна дыра: новый тип можно завести, ПРОСТО НЕ ПОЗВАВ
# макрос. Этот прибор закрывает ровно её и больше ничего. Судить форму типа
# второй раз текстом значило бы завести второй ответ на один вопрос — а это
# тот самый дефект, который CANON S11 называет дефектом («вторая реализация
# того, что канон объявляет одной системой»).
#
# ПОЧЕМУ СПИСОК ЗАГОЛОВКОВ ВЕДЁТСЯ РУКАМИ
# ---------------------------------------
# Сознательно, и это не лень. «Строка мира» — суждение о СМЫСЛЕ файла, и из
# текста оно не выводится. `MacroGrid` в `world/macro_grid.h` строкой мира НЕ
# является: он владелец двух плоских массивов, и `std::vector` в нём законен —
# вектор длиной мира есть плоский массив, а не контейнер. Строка мира в том же
# файле — `SubMask`, которая умножается на 2^21 клеток. Отличить одно от
# другого умеет человек, а не регэксп; поэтому список положительный, живёт
# здесь один раз, и новая строка в нём есть ЗАПИСЬ РЕШЕНИЯ.
#
# ЗАПУСК
# ------
#   cmake -P tools/check_row_law.cmake
#
# Зарегистрирован как ctest `row_law`.
cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED GIGA_ROOT)
    get_filename_component(GIGA_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()

# ЗАГОЛОВКИ-СТРОКИ. Расширяется решением владельца — новая строка здесь и есть
# запись этого решения. Каждая снабжена доводом, ПОЧЕМУ её структуры суть
# строки мира: без довода строка списка со временем становится карго-культом.
set(GIGA_ROW_HEADERS
    # POD-компоненты ECS. EnTT хранит каждую в пуле и умножает на число
    # сущностей; член с кучей переселил бы аллокацию в тик.
    src/ecs/components.h
    # Якорь — единый контакт с миром (CANON S20). Ездит в сейве этажа, в
    # staging GPU и в строке пропа; все три пути байтовые.
    src/world/anchor.h
    # Ответ примитива запроса поверхностей (CANON S10), отдаётся по значению
    # десятками тысяч раз за бейк.
    src/world/surface.h
    # `SubMask` × 2^21 клеток = 128 МиБ одним блоком, едет в снимок этажа
    # байтами и в staging GPU. (`MacroGrid` — владелец, не строка; см. шапку.)
    src/world/macro_grid.h
    # Инвентарь — один и тот же прямоугольник на строке пула NPC, на
    # ECS-сущности и на игроке; шапка обещает «byte-copy of its macro row».
    src/game/inventory.h
    # Событие — ОДИН род записи, которым прошлое выходит из мира; ездит
    # кольцом фиксированной ёмкости и обязано переживать memcpy. Единственная
    # `^struct` в файле: владелец `EventBus` объявлен `class`.
    src/game/event_bus.h)

set(GIGA_ROW_FAILURES "")
set(GIGA_ROW_STRUCTS 0)
set(GIGA_ROW_CONTOURS 0)

# _giga_read_lines(<out-var> <path>) — ПОСТРОЧНОЕ ЧТЕНИЕ, КОТОРОЕ НЕ ВРЁТ.
#
# `file(STRINGS)` здесь стоял и был СНЕСЁН замером 2026-10-01. Он извлекает из
# файла только последовательности печатаемого ASCII, а всё остальное считает
# разделителем — то есть на кириллице и на кавычках-ёлочках рвёт строку на
# куски. Числом: SKELETON.md в 833 строки дал 6397 элементов, и счётчик строк
# прибора врал в семь раз (отказы рапортовались на «SKELETON.md:2571», которой
# в файле нет). Шапки модулей в `src/` тоже по-русски, поэтому тот же обман
# работал и на исходниках — значит и номер строки отпечатка был бы неверным.
#
# `file(READ)` + ручная разбивка держит UTF-8 целиком. Экранирование `;` ДО
# разбивки обязательно: без него точка с запятой внутри строки (а ею кончается
# каждая строка C++) расщепила бы элемент списка, и счёт поехал бы снова.
# Проверено пробником: 833 строки → 834 элемента (последний — хвост после
# завершающего перевода строки), и элемент[753] есть ровно строка 754.
macro(_giga_read_lines _out _path)
    file(READ "${_path}" _giga_rl_body)
    # ЛИТЕРАЛЬНЫЙ `string(REPLACE)`, а не `REGEX REPLACE`: последний отвергает
    # `\;` в выражении замены («Unknown escape»), потому что разбирает её как
    # регулярное выражение. Поймано прогоном 2026-10-01.
    string(REPLACE ";" "\\;" _giga_rl_body "${_giga_rl_body}")
    string(REPLACE "\n" ";" ${_out} "${_giga_rl_body}")
endmacro()

foreach(_rel IN LISTS GIGA_ROW_HEADERS)
    set(_path "${GIGA_ROOT}/${_rel}")
    if(NOT EXISTS "${_path}")
        list(APPEND GIGA_ROW_FAILURES
            "${_rel}:1: заголовок-строка из списка этого прибора в дереве НЕ НАЙДЕН. Либо файл переехал и список устарел, либо строки мира снесены — и то и другое решает человек, а молчать об этом нельзя.")
        continue()
    endif()

    _giga_read_lines(_lines "${_path}")

    # Заголовок-строка ОБЯЗАН включать контур. Без включения все вызовы ниже
    # были бы просто неизвестными идентификаторами — то есть сборка упала бы, —
    # но проверка стоит здесь затем, чтобы отказ назывался своим именем.
    set(_hasInclude FALSE)
    foreach(_l IN LISTS _lines)
        string(FIND "${_l}" "core/row_law.h" _at)
        if(NOT _at EQUAL -1)
            set(_hasInclude TRUE)
            break()
        endif()
    endforeach()
    if(NOT _hasInclude)
        list(APPEND GIGA_ROW_FAILURES
            "${_rel}:1: заголовок-строка не включает core/row_law.h — значит контура в нём нет ни у одной структуры.")
    endif()

    # ---- Собрать объявленные структуры и поставленные контуры ---------------
    #
    # `struct` распознаётся ТОЛЬКО с начала строки. Это сознательно строго:
    # вложенная структура живёт с отступом и строкой мира не является, а её
    # внешняя — является, и контур на внешней накрывает вложенную по
    # построению (`is_trivially_copyable` спрашивает ЧЛЕНОВ).
    set(_declared "")
    set(_contoured "")
    set(_lineOf "")
    set(_n 0)
    foreach(_l IN LISTS _lines)
        math(EXPR _n "${_n} + 1")

        # Объявление структуры. Предобъявление (`struct Foo;`) структурой не
        # является — контур на неполный тип поставить нельзя в принципе.
        if(_l MATCHES "^struct[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*(\\{|$)")
            list(APPEND _declared "${CMAKE_MATCH_1}")
            list(APPEND _lineOf "${CMAKE_MATCH_1}=${_n}")
            math(EXPR GIGA_ROW_STRUCTS "${GIGA_ROW_STRUCTS} + 1")
        endif()

        # Вызов контура. Имя берётся ХВОСТОМ после последнего `::` — иначе
        # пришлось бы вести словарь пространств имён, то есть второй словарь
        # ради ничего. Обе формы макроса ловятся одним выражением.
        if(_l MATCHES "GIGA_ROW(_BYTES)?[ \t]*\\(([A-Za-z0-9_:]+)")
            set(_qual "${CMAKE_MATCH_2}")
            string(REGEX REPLACE "^.*::" "" _bare "${_qual}")
            list(APPEND _contoured "${_bare}")
            math(EXPR GIGA_ROW_CONTOURS "${GIGA_ROW_CONTOURS} + 1")
        endif()
    endforeach()

    foreach(_s IN LISTS _declared)
        list(FIND _contoured "${_s}" _found)
        if(_found LESS 0)
            set(_at "?")
            foreach(_pair IN LISTS _lineOf)
                if(_pair MATCHES "^${_s}=([0-9]+)$")
                    set(_at "${CMAKE_MATCH_1}")
                    break()
                endif()
            endforeach()
            list(APPEND GIGA_ROW_FAILURES
                "${_rel}:${_at}: СТРОКА МИРА БЕЗ КОНТУРА — struct ${_s}. Допиши GIGA_ROW(<ns>::${_s}); в блок контура внизу файла. Без контура новый тип обходит компиляторную стену МОЛЧА: vector/string/map/unique_ptr/virtual членом соберутся, аллокация переедет в тик, а байтовый путь (сейв, staging GPU) начнёт копировать указатель процесса.")
        endif()
    endforeach()

    # Контур на структуру, которой в файле нет, — вторая половина храповика:
    # он должен краснеть В ОБЕ СТОРОНЫ. Иначе снос структуры оставил бы
    # мёртвый вызов, и прибор считал бы его за работу.
    foreach(_c IN LISTS _contoured)
        list(FIND _declared "${_c}" _found)
        if(_found LESS 0)
            list(APPEND GIGA_ROW_FAILURES
                "${_rel}:1: КОНТУР БЕЗ СТРОКИ — GIGA_ROW(...${_c}) стоит, а `struct ${_c}` в этом файле нет. Либо структуру снесли и вызов осиротел, либо она переехала, либо имя написано с опечаткой — и тогда контура у неё нет вовсе, хотя список выглядит полным.")
        endif()
    endforeach()
endforeach()

# ---- Сторож: прибор, не нашедший структур, обязан упасть -------------------
# Ноль нарушений должен означать «закон соблюдён», а не «разбор сломался».
# Это тот же класс дефекта, что `scanned 0 files` у source_rules: проверка,
# молча не увидевшая ничего, читается как зелёная.
if(GIGA_ROW_STRUCTS LESS 20)
    list(APPEND GIGA_ROW_FAILURES
        "tools/check_row_law.cmake:1: прибор нашёл всего ${GIGA_ROW_STRUCTS} структур в заголовках-строках. Их там больше двадцати (одна `src/ecs/components.h` несёт 19), значит разбор `^struct` сломан или список заголовков опустел — и зелёный вердикт означал бы сломанный обход, а не соблюдённый закон.")
endif()

list(LENGTH GIGA_ROW_FAILURES GIGA_ROW_FAILURE_COUNT)
if(GIGA_ROW_FAILURE_COUNT GREATER 0)
    message("GIGA_ROW_LAW=FAIL")
    foreach(_f IN LISTS GIGA_ROW_FAILURES)
        message("- ${_f}")
    endforeach()
    message(FATAL_ERROR
        "${GIGA_ROW_FAILURE_COUNT} нарушений полноты контура. Контур — "
        "разделение труда с компилятором: ЗАКОН судит он, а этот прибор "
        "судит только то, позвали ли закон. Допиши вызов; не ослабляй "
        "прибор и не вычёркивай заголовок из списка.")
endif()

message("GIGA_ROW_LAW=PASS structs=${GIGA_ROW_STRUCTS} contours=${GIGA_ROW_CONTOURS}")
