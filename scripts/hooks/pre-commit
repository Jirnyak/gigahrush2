#!/bin/sh
# =============================================================================
# GIGAHRUSH 2 — THE IRON GATE & ANTI-SLOP PRE-COMMIT GUARD
# Unified Master Inquisitor (tools/run_all_guards.py)
# =============================================================================

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=""
if [ -n "$ROOT" ]; then
    cd "$ROOT" || exit 1
fi

python tools/run_all_guards.py --mode=pre-commit --staged
if [ $? -ne 0 ]; then
    echo "================================================================================"
    echo "BLOCKED: Iron Gate остановил коммит."
    echo "Устраните дефекты по Failure Manifesto выше. Коммит отклонен."
    echo "================================================================================"
    exit 1
fi

exit 0
