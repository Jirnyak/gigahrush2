#version 450
// verlet_sim.comp — THE GPU verlet for antourage: wires AND cloth in one
// shader. A chain is just a W x 1 lattice: at H == 1 the vertical constraint
// loop never runs and the horizontal loop degenerates into the old wire chain
// sweep in the same traversal order, so no chain-specific code exists at all
// (the merge's central fact, markoaudit/plans/verlet-merge.md §2.3).
//
// ONE-WAY by law ([game/antourage/antourage.h]): bodies push antourage,
// antourage pushes nothing back — the whole sim lives on the render side and
// the CPU tick pays zero. One invocation per ELEMENT (a chain of 8 or a sheet
// of 32 points): counts are tiny, so the constraint relaxation runs serially
// per thread and needs no cross-invocation sync.
//
// Layout must stay in LOCKSTEP with gpu::GpuWireChain / gpu::GpuClothSheet
// (render/verlet_pass.h) and shaders/wire.vert / cloth.vert. An element is
// {vec4 meta; vec4 cur[P]; vec4 prev[P]} with P = W*H from the push block —
// byte-for-byte the old per-kind records, addressed here as raw vec4s so ONE
// shader walks both strides. meta.x = horizontal rest, meta.y = alive flag
// (CPU writes it from the anchor probe), meta.z = vertical rest (a chain
// parks massKg there — never read at H == 1), cur.w = inverse mass
// (0 = pinned point).

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Points { vec4 v[]; } eb;
// This frame's push bodies: xyz = world pos, w = radius. EVERY body on the
// layer is here — the player is one of them, an NPC with a camera, never a
// special case (owner's law).
layout(std430, binding = 1) readonly buffer Bodies { vec4 b[]; } bb;

// VoxelMirror masks — the same SSBO particle_sim.comp collides against, so a
// piece that lost its last pin FALLS AND LANDS instead of sinking through the
// floor. One view of the truth, one collision rule.
layout(std430, binding = 2) readonly buffer MaskBuf { uint uMasks[]; };

// Solidity of the sub-voxel containing world point `w` (toroidal).
// Cell = 2 m, sub-voxel = 0.25 m; kMacroDim = 128 so wrap is a power-of-two AND.
bool solid_at(vec3 w) {
    vec3 q = w * 0.5;
    ivec3 c = ivec3(floor(q)) & (GIGA_MACRO_DIM - 1);
    ivec3 sv = ivec3(floor(fract(q) * 8.0)) & 7;
    uint ci = uint(c.x) | (uint(c.y) << 7) | (uint(c.z) << 14);
    uint bit = uint(sv.x) | (uint(sv.y) << 3) | (uint(sv.z) << 6);
    return ((uMasks[ci * 16u + (bit >> 5)] >> (bit & 31u)) & 1u) != 0u;
}

// Move a free point toward `np` without entering matter: each axis advances
// alone and simply does not move when the sub-voxel it would enter is solid.
// Axis-wise is what lets a point resting on a floor keep sliding along it.
//
// Verlet needs no extra bookkeeping for the stop: `prev` stays the pre-step
// position, so a blocked axis ends with cur == prev — velocity zero on exactly
// that axis, full speed on the others. (Writing prev by hand here is how the
// first draft made points buzz inside walls.)
vec3 world_land(vec3 cur, vec3 np) {
    vec3 pos = cur;
    for (int a = 0; a < 3; ++a) {
        vec3 cand = pos;
        cand[a] = np[a];
        if (!solid_at(cand)) pos[a] = np[a];
    }
    return pos;
}

// One name, one meaning per field — the three old SimPush structs died with
// the wire/cloth pass merge (sim.w used to mean damping OR the torus period
// depending on the file; never again).
layout(push_constant) uniform VerletPush {
    vec4 dims; // x = element count, y = body count, z = grid W, w = grid H
    vec4 sim;  // x = dt, y = damping, z = wrap period (m), w = unused
    vec4 grav; // xyz = gravity acceleration VECTOR (m/s^2), w = unused — NEVER assume -Z
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.dims.x)) return;

    const int W = int(pc.dims.z);
    const int H = int(pc.dims.w);
    const int P = W * H;
    const uint curB = i * uint(1 + 2 * P) + 1u;  // element base, past meta
    const uint prevB = curB + uint(P);

    vec4 meta = eb.v[curB - 1u];
    if (meta.y < 0.5) return;           // dead element: anchors carved away

    const float dt = pc.sim.x;
    const float restX = meta.x;
    const float restY = meta.z;
    const float per = pc.sim.z;

    // Verlet integrate every free point, bodies pushing (torus-wrapped delta).
    for (int k = 0; k < P; ++k) {
        vec4 cur = eb.v[curB + uint(k)];
        if (cur.w == 0.0) continue;     // pinned point
        vec3 vel = (cur.xyz - eb.v[prevB + uint(k)].xyz) * pc.sim.y;
        vec3 np = cur.xyz + vel + pc.grav.xyz * dt * dt;
        for (uint bi = 0u; bi < uint(pc.dims.y); ++bi) {
            vec3 dp = np - bb.b[bi].xyz;
            dp -= per * floor(dp / per + 0.5);
            float r = bb.b[bi].w;
            float d2 = dot(dp, dp);
            if (d2 < r * r && d2 > 1e-6) {
                float d = sqrt(d2);
                np += dp / d * (r - d) * 0.35;
            }
        }
        // Land on the world instead of sinking through it (see world_land:
        // `prev` staying put IS the stop).
        eb.v[prevB + uint(k)] = vec4(cur.xyz, 0.0);
        eb.v[curB + uint(k)] = vec4(world_land(cur.xyz, np), cur.w);
    }

    // Distance constraints, a few relaxation sweeps. At H == 1 the horizontal
    // sweep IS the old wire chain loop (r = 0, c = 0..W-2, same order) and the
    // vertical sweep never executes.
    for (int it = 0; it < 4; ++it) {
        // Horizontal neighbours.
        for (int r = 0; r < H; ++r)
            for (int c = 0; c < W - 1; ++c) {
                uint a = curB + uint(r * W + c), e = a + 1u;
                vec4 A = eb.v[a];
                vec4 B = eb.v[e];
                vec3 d = B.xyz - A.xyz;
                float len = length(d);
                if (len < 1e-5) continue;
                float ws = A.w + B.w;
                if (ws <= 0.0) continue;
                vec3 corr = d * ((len - restX) / len);
                eb.v[a].xyz += corr * (A.w / ws);
                eb.v[e].xyz -= corr * (B.w / ws);
            }
        // Vertical neighbours.
        for (int r = 0; r < H - 1; ++r)
            for (int c = 0; c < W; ++c) {
                uint a = curB + uint(r * W + c), e = a + uint(W);
                vec4 A = eb.v[a];
                vec4 B = eb.v[e];
                vec3 d = B.xyz - A.xyz;
                float len = length(d);
                if (len < 1e-5) continue;
                float ws = A.w + B.w;
                if (ws <= 0.0) continue;
                vec3 corr = d * ((len - restY) / len);
                eb.v[a].xyz += corr * (A.w / ws);
                eb.v[e].xyz -= corr * (B.w / ws);
            }
    }
}
