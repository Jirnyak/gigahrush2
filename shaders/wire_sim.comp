#version 450
// wire_sim.comp — GPU verlet for hanging wires (antourage GHOST chains).
//
// ONE-WAY by law ([game/antourage/antourage.h]): bodies push wires, wires never
// push anything back — the whole sim lives on the render side and the CPU tick
// pays zero. One invocation per CHAIN (8 points): counts are tiny (~100 chains
// per floor), so the constraint relaxation runs serially per thread and needs
// no cross-invocation sync at all.
//
// Layout must stay in LOCKSTEP with gpu::GpuWireChain (render/wire_pass.h) and
// shaders/wire.vert: {vec4 meta; vec4 cur[8]; vec4 prev[8]}, meta.x = segment
// rest length, meta.y = alive flag (CPU writes it from the anchor probe),
// cur.w = inverse mass (0 = pinned endpoint).

layout(local_size_x = 64) in;

struct WChain {
    vec4 meta;
    vec4 cur[8];
    vec4 prev[8];
};

layout(std430, binding = 0) buffer Wires { WChain c[]; } wb;
// This frame's push bodies: xyz = world pos, w = radius. EVERY body on the
// layer is here — the player is one of them, an NPC with a camera, never a
// special case (owner's law).
layout(std430, binding = 1) readonly buffer Bodies { vec4 b[]; } bb;

// VoxelMirror masks — the same SSBO particle_sim.comp collides against, so a
// piece that lost its last pin FALLS AND LANDS instead of sinking through the
// floor. One view of the truth, one collision rule.
layout(std430, binding = 2) readonly buffer MaskBuf { uint uMasks[]; };

// Solidity of the sub-voxel containing world point `w` (toroidal).
// Cell = 2 m, sub-voxel = 0.25 m; 512x512x16 sector grid.
bool solid_at(vec3 w) {
    vec3 q = w * 0.5;
    ivec3 c = ivec3(floor(q));
    c.x &= 511;
    c.y &= 511;
    c.z &= 15;
    ivec3 sv = ivec3(floor(fract(q) * 8.0)) & 7;
    uint ci = uint(c.x) | (uint(c.y) << 9) | (uint(c.z) << 18);
    uint bit = uint(sv.x) | (uint(sv.y) << 3) | (uint(sv.z) << 6);
    return ((uMasks[ci * 16u + (bit >> 5)] >> (bit & 31u)) & 1u) != 0u;
}

// Move a free point toward `np` without entering matter: each axis advances
// alone and simply does not move when the sub-voxel it would enter is solid.
// Axis-wise is what lets a point resting on a floor keep sliding along it.
//
// Verlet needs no extra bookkeeping for the stop: `prev` stays the pre-step
// position, so a blocked axis ends with cur == prev — velocity zero on exactly
// that axis, full speed on the others. (Writing prev by hand here is how the
// first draft made points buzz inside walls.)
vec3 world_land(vec3 cur, vec3 np) {
    vec3 pos = cur;
    for (int a = 0; a < 3; ++a) {
        vec3 cand = pos;
        cand[a] = np[a];
        if (!solid_at(cand)) pos[a] = np[a];
    }
    return pos;
}

layout(push_constant) uniform Push {
    vec4 sim;  // x = dt, y = unused, z = chain count, w = damping
    vec4 aux;  // x = body count, y = wrap period (m)
    vec4 grav; // xyz = gravity acceleration VECTOR (m/s^2), w = unused
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.sim.z)) return;
    if (wb.c[i].meta.y < 0.5) return;   // dead chain: anchors carved away

    const float dt = pc.sim.x;
    const float rest = wb.c[i].meta.x;

    // Verlet integrate every free point.
    for (int k = 0; k < 8; ++k) {
        vec4 cur = wb.c[i].cur[k];
        if (cur.w == 0.0) continue;     // pinned anchor point
        vec3 vel = (cur.xyz - wb.c[i].prev[k].xyz) * pc.sim.w;
        vec3 np = cur.xyz + vel + pc.grav.xyz * dt * dt;
        // Bodies brushing through: a soft radial push per body (one-way).
        // Deltas wrap on the torus so a body across the seam still pushes.
        float per = pc.aux.y;
        for (uint bi = 0u; bi < uint(pc.aux.x); ++bi) {
            vec3 dp = np - bb.b[bi].xyz;
            dp -= per * floor(dp / per + 0.5);
            float r = bb.b[bi].w;
            float d2 = dot(dp, dp);
            if (d2 < r * r && d2 > 1e-6) {
                float d = sqrt(d2);
                np += dp / d * (r - d) * 0.35;
            }
        }
        wb.c[i].prev[k] = vec4(cur.xyz, 0.0);
        wb.c[i].cur[k] = vec4(np, cur.w);
    }

    // Distance constraints, a few relaxation sweeps.
    for (int it = 0; it < 4; ++it)
        for (int k = 0; k < 7; ++k) {
            vec4 A = wb.c[i].cur[k];
            vec4 B = wb.c[i].cur[k + 1];
            vec3 d = B.xyz - A.xyz;
            float len = length(d);
            if (len < 1e-5) continue;
            float ws = A.w + B.w;
            if (ws <= 0.0) continue;
            vec3 corr = d * ((len - rest) / len);
            wb.c[i].cur[k].xyz += corr * (A.w / ws);
            wb.c[i].cur[k + 1].xyz -= corr * (B.w / ws);
        }

    // Final collision projection so constraints never pull nodes inside solid matter.
    for (int k = 0; k < 8; ++k) {
        if (wb.c[i].cur[k].w == 0.0) continue;
        vec3 p = wb.c[i].cur[k].xyz;
        wb.c[i].cur[k].xyz = world_land(wb.c[i].prev[k].xyz, p);
    }
}
