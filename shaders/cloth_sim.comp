#version 450
// cloth_sim.comp — GPU verlet for 2D sheets (the antourage CLOTH primitive:
// curtains, tarps, membranes). Same one-way law as wire_sim.comp: bodies push
// cloth, cloth pushes nothing back. One invocation per SHEET (32 points, an
// 8x4 grid, row-major from the top): counts are small, so the constraint
// relaxation runs serially per thread.
//
// Layout must stay in LOCKSTEP with gpu::GpuClothSheet
// (render/cloth_pass.h) and shaders/cloth.vert: {vec4 meta; vec4 cur[32];
// vec4 prev[32]}. meta.x = horizontal rest, meta.y = alive flag, meta.z =
// vertical rest; cur.w = inverse mass (0 = pinned — the top row).

layout(local_size_x = 64) in;

struct Sheet {
    vec4 meta;
    vec4 cur[32];
    vec4 prev[32];
};

layout(std430, binding = 0) buffer Sheets { Sheet s[]; } sb;
// This frame's push bodies: xyz = world pos, w = radius. EVERY body on the
// layer — the player is one of them, never a special case (owner's law).
layout(std430, binding = 1) readonly buffer Bodies { vec4 b[]; } bb;

// VoxelMirror masks — the same SSBO particle_sim.comp collides against, so a
// piece that lost its last pin FALLS AND LANDS instead of sinking through the
// floor. One view of the truth, one collision rule.
layout(std430, binding = 2) readonly buffer MaskBuf { uint uMasks[]; };

// Solidity of the sub-voxel containing world point `w` (toroidal).
// Cell = 2 m, sub-voxel = 0.25 m; kMacroDim = 128 so wrap is a power-of-two AND.
bool solid_at(vec3 w) {
    vec3 q = w * 0.5;
    ivec3 c = ivec3(floor(q)) & 127;
    ivec3 sv = ivec3(floor(fract(q) * 8.0)) & 7;
    uint ci = uint(c.x) | (uint(c.y) << 7) | (uint(c.z) << 14);
    uint bit = uint(sv.x) | (uint(sv.y) << 3) | (uint(sv.z) << 6);
    return ((uMasks[ci * 16u + (bit >> 5)] >> (bit & 31u)) & 1u) != 0u;
}

// Move a free point toward `np` without entering matter: each axis advances
// alone and simply does not move when the sub-voxel it would enter is solid.
// Axis-wise is what lets a point resting on a floor keep sliding along it.
//
// Verlet needs no extra bookkeeping for the stop: `prev` stays the pre-step
// position, so a blocked axis ends with cur == prev — velocity zero on exactly
// that axis, full speed on the others. (Writing prev by hand here is how the
// first draft made points buzz inside walls.)
vec3 world_land(vec3 cur, vec3 np) {
    vec3 pos = cur;
    for (int a = 0; a < 3; ++a) {
        vec3 cand = pos;
        cand[a] = np[a];
        if (!solid_at(cand)) pos[a] = np[a];
    }
    return pos;
}

layout(push_constant) uniform Push {
    vec4 sim;  // x = dt, y = unused, z = sheet count, w = damping
    vec4 aux;  // x = body count, y = wrap period (m)
    vec4 grav; // xyz = gravity acceleration VECTOR (m/s^2), w = unused
} pc;

const int W = 8;
const int H = 4;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.sim.z)) return;
    if (sb.s[i].meta.y < 0.5) return; // dead sheet: anchors carved away

    const float dt = pc.sim.x;
    const float restX = sb.s[i].meta.x;
    const float restY = sb.s[i].meta.z;
    const float per = pc.aux.y;

    // Verlet integrate every free point, bodies pushing (torus-wrapped delta).
    for (int k = 0; k < W * H; ++k) {
        vec4 cur = sb.s[i].cur[k];
        if (cur.w == 0.0) continue; // pinned
        vec3 vel = (cur.xyz - sb.s[i].prev[k].xyz) * pc.sim.w;
        vec3 np = cur.xyz + vel + pc.grav.xyz * dt * dt;
        for (uint bi = 0u; bi < uint(pc.aux.x); ++bi) {
            vec3 dp = np - bb.b[bi].xyz;
            dp -= per * floor(dp / per + 0.5);
            float r = bb.b[bi].w;
            float d2 = dot(dp, dp);
            if (d2 < r * r && d2 > 1e-6) {
                float d = sqrt(d2);
                np += dp / d * (r - d) * 0.35;
            }
        }
        sb.s[i].prev[k] = vec4(cur.xyz, 0.0);
        sb.s[i].cur[k] = vec4(np, cur.w);
    }

    // Distance constraints along both axes, a few relaxation sweeps.
    for (int it = 0; it < 4; ++it) {
        // Horizontal neighbours.
        for (int r = 0; r < H; ++r)
            for (int c = 0; c < W - 1; ++c) {
                int a = r * W + c, e = a + 1;
                vec4 A = sb.s[i].cur[a];
                vec4 B = sb.s[i].cur[e];
                vec3 d = B.xyz - A.xyz;
                float len = length(d);
                if (len < 1e-5) continue;
                float ws = A.w + B.w;
                if (ws <= 0.0) continue;
                vec3 corr = d * ((len - restX) / len);
                sb.s[i].cur[a].xyz += corr * (A.w / ws);
                sb.s[i].cur[e].xyz -= corr * (B.w / ws);
            }
        // Vertical neighbours.
        for (int r = 0; r < H - 1; ++r)
            for (int c = 0; c < W; ++c) {
                int a = r * W + c, e = a + W;
                vec4 A = sb.s[i].cur[a];
                vec4 B = sb.s[i].cur[e];
                vec3 d = B.xyz - A.xyz;
                float len = length(d);
                if (len < 1e-5) continue;
                float ws = A.w + B.w;
                if (ws <= 0.0) continue;
                vec3 corr = d * ((len - restY) / len);
                sb.s[i].cur[a].xyz += corr * (A.w / ws);
                sb.s[i].cur[e].xyz -= corr * (B.w / ws);
            }
    }

    // Final collision projection so constraints never pull cloth vertices inside solid matter.
    for (int k = 0; k < W * H; ++k) {
        if (sb.s[i].cur[k].w == 0.0) continue;
        vec3 p = sb.s[i].cur[k].xyz;
        sb.s[i].cur[k].xyz = world_land(sb.s[i].prev[k].xyz, p);
    }
}
