#version 450
// light_grid.comp — GPU compute shader for 3D volumetric light grid binning.

layout(local_size_x = 8, local_size_y = 4, local_size_z = 8) in;

struct PointLight {
    vec4 posRadius;      // xyz = world position (m), w = radius (m)
    vec4 colorIntensity; // rgb = linear color (0..1), w = effective intensity
    vec4 dirCone;        // xyz = spot dir, w = cos(outer half-angle); <= -1.5 = омни.
                         // Биннинг конус НЕ режет — сфера радиуса консервативна;
                         // конус применяют потребители (surface_light / fog march).
};

// Ёмкость клетки ВЫВОДИТСЯ из байтов клетки: -DGIGA_LIGHT_CELL_BYTES из
// CMakeLists <- gpu_light_grid.h kGridCellBytes (правило 9 гейта — литералам
// сетки в шейдерах нельзя). Слоты = байты/слово − счётчик.
const uint kCellSlots = uint(GIGA_LIGHT_CELL_BYTES) / 4u - 1u;

// Надгробие: intensity ниже порога = слот мёртв до ребейка. Обязан совпадать
// с kTombstoneIntensity в gpu_light_grid.h (CPU режет тем же порогом).
const float kTombstone = 0.001;

struct LightGridCell {
    uint count;                    // number of intersecting lights (max kCellSlots)
    uint lightIndices[kCellSlots]; // indices into uPointLights array
};

// НЕ readonly: слово uCellOverflow — атомарный счётчик клеток, переливших
// kCellSlots за кадр; CPU (update_and_dispatch) читает его кадром позже и
// печатает — перелив больше не молчит (закон S11).
layout(set = 0, binding = 0, std430) buffer PointLightBuffer {
    uint uPointLightCount;
    uint uCellOverflow;
    uint uReserved1;     // бывший бюджет ламп дымки — член удалён 2026-08-20
    uint uShadowRayOverride; // компьют не читает; потребитель — surface_light
    PointLight uPointLights[];
};

layout(set = 0, binding = 1, std430) writeonly buffer LightGridBuffer {
    LightGridCell uGridCells[];
};

// Запечённая видимость «лампа -> клетка» ([game/light_vis_bake]): статики,
// которые В ПРИНЦИПЕ достижимы для клетки (строгий флуд, консервативно).
// Список уже отсортирован по вкладу; интенсивности живут в uPointLights.
layout(set = 0, binding = 2, std430) readonly buffer BakedGridBuffer {
    LightGridCell uBakedCells[];
};

// Поколение мутации, запачкавшей клетку (пишет CPU-дренаж карва тем же
// кадром). Клетка грязная <=> uDirtyGen[cell] > pc.genBaked; очистки нет —
// свап бейка просто поднимает genBaked (план light-visibility-bake §1.2).
layout(set = 0, binding = 3, std430) readonly buffer DirtyGenBuffer {
    uint uDirtyGen[];
};

// Бакеты динамического хвоста (проблема 59.14): CPU сплатит каждый динамик
// (снаряд, моб-эмиттер, фонарь) сферой в решётку dynBucketDim³; клетка
// читает ТОЛЬКО свой бакет вместо прохода по всему хвосту. Слово 0 бакета —
// счётчик; kDynFallback = перелив: клетка честно сканирует весь хвост
// (ошибка — «заплатить больше», никогда «потерять лампу»).
layout(set = 0, binding = 4, std430) readonly buffer DynBucketBuffer {
    uint uDynBuckets[];
};
const uint kDynFallback = 0xFFFFFFFFu;

// Кластерная топология статиков (инкремент 4 carve-hitch.md): 32³ бакетов
// по 8 м, пары (memberStart, memberCount) + CSR ламповых id. Грязная клетка
// У КАМЕРЫ сканирует только соседние бакеты — «все лампы радиуса» без
// прохода по всей таблице (каждая лампа — член ровно одного бакета, лампа
// достающая клетку лежит в бакете не дальше R_max + полудиагоналей).
layout(set = 0, binding = 5, std430) readonly buffer ClusterBucketBuffer {
    uint uClusterBucketRange[]; // пары (start, count) по бакетам
};
layout(set = 0, binding = 6, std430) readonly buffer ClusterMemberBuffer {
    uint uClusterMembers[];
};

// Камеры в пуше НЕТ по построению: биннинг камеронезависим (S7), и мёртвая
// лейна camPos возилась зря (аудит 2026-08-20). uTime/maxLights тоже умерли:
// слоты приходят дефайном, время компьюту не нужно.
layout(push_constant) uniform GridPush {
    vec4 gridMin;   // xyz = min-угол сетки в мире, w = размер клетки x/z (4.0 м)
    vec4 gridExt;   // xyz = размеры сетки (64,64,64), w = размер клетки y (4.0 м)
    vec4 params;    // x = activeLightCount,
                    // y = TORUS WRAP PERIOD in metres (kWorldExtent, pushed by the host)
                    // z = R_max бейка (м), w = кластерная топология залита (0/1)
    vec4 camPos;    // xyz = камера; w = порог «близко» для грязного фоллбэка
                    // (2×R_max — вывод в gpu_light_grid.h). Камера в пуше —
                    // ТОЛЬКО для этого гейта: закон «свет в дыру тем же
                    // кадром» камерный (решение владельца 2026-08-21), биннинг
                    // чистых клеток по-прежнему камеронезависим (S7).
    uint genBaked;       // поколение мира в живом bakedGrid
    uint genStaticCount; // граница секций таблицы: [0..S) статики, [S..N) динамики
    uint dynBucketDim;   // решётка бакетов динамиков (= kDynBucketDim хоста)
    uint dynBucketSlots; // слотов на бакет (= kDynBucketSlots хоста)
} pc;

// Toroidal wrap. The period is PUSHED, never written here: this helper used to be
// called with a literal 128.0 against a 256 m world, which is the half-period
// mistake [problems.md] §7 spent a month on.
float wrap_delta(float a, float b, float L) {
    float d = b - a;
    return d - L * floor((d + L * 0.5) / L);
}

float dist_sq_point_aabb_toroidal(vec3 p, vec3 bMin, vec3 bMax, float L) {
    vec3 cCenter = (bMin + bMax) * 0.5;
    vec3 cHalf   = (bMax - bMin) * 0.5;

    // ALL THREE AXES. y used to be a bare subtraction, and that was the live bug:
    // the world wraps on x, y and z alike ([AGENTS.md] §Toroidal invariants), so a
    // lamp two metres away across the y seam measured ~254 m, landed outside the
    // grid box and was never binned into any cell — the fog stayed dark exactly
    // where a light was. The consumer (volumetric_fog.glsl) already wrapped y
    // correctly, so producer and consumer disagreed about the shape of the world.
    float dx = wrap_delta(cCenter.x, p.x, L);
    float dy = wrap_delta(cCenter.y, p.y, L);
    float dz = wrap_delta(cCenter.z, p.z, L);

    vec3 delta = max(vec3(0.0), abs(vec3(dx, dy, dz)) - cHalf);
    return dot(delta, delta);
}

// Кооперативный тайл биннинга: 256 потоков воркгруппы грузят 256 светов
// (posRadius + интенсивность — скип надгробий) в shared один раз, и каждый
// тестирует их против своей клетки. Наивный вариант читал полный 48-байтовый
// структ на каждую пару клетка×свет: 262144 клетки × 512 светов × 48 B =
// 6.4 GB/кадр из VRAM — 26 мс кадра на плотном этаже (замер 2026-08-17).
// Тайл режет чтения в 256 раз (одна загрузка на воркгруппу, не на поток).
shared vec4 sTile[256];
shared float sTileW[256];
// Грязность воркгруппы: OR по клеткам ДО тайлового цикла, чтобы решение
// «идти ли в цикл с barrier()» было воркгруппо-однородным (неоднородный
// контроль вокруг barrier — UB).
shared uint sGroupDirty;

// Состояние top-K клетки — глобалы инвокации: три источника кандидатов
// (тайловый фолбэк, запечённый список, динамики) кормят один отбор.
uint  gFound = 0u;
uint  gCandidates = 0u; // все достижимые, включая вытесненных, — перелив вслух
uint  gIndices[kCellSlots];
float gScores[kCellSlots];
// Худший слот кэшируется и пересчитывается ТОЛЬКО после замены — скан
// всех слотов на каждого кандидата давал 26 мс кадра в плотном поле ламп
// (блейм, ~200 кандидатов на клетку; замер 2026-08-17 ещё на 31 слоте).
uint  gWorst = 0u;
float gWorstScore = -1.0;

// Перелив клетки решается ВКЛАДОМ В КЛЕТКУ (top-K по d²/r²), а не порядком
// CPU-сортировки по камере. Порядок-по-камере был живым багом: у плотного
// кластера ламп подлёт камеры отдавал весь лимит клетки лампам У КАМЕРЫ,
// дальние клетки теряли свои родные лампы, и комната ТЕМНЕЛА при
// приближении к свету (репорт владельца со скринами, 2026-08-17). Вклад в
// клетку от камеры не зависит — картинка стабильна с любого расстояния.
void consider(uint id, float score) {
    gCandidates++;
    if (gFound < kCellSlots) {
        gIndices[gFound] = id;
        gScores[gFound] = score;
        if (score > gWorstScore) { gWorstScore = score; gWorst = gFound; }
        gFound++;
        return;
    }
    // Полный список: вытесняем худшего, если новый вкладнее.
    if (score < gWorstScore) {
        gIndices[gWorst] = id;
        gScores[gWorst] = score;
        gWorstScore = -1.0;
        for (uint k = 0u; k < kCellSlots; ++k) {
            if (gScores[k] > gWorstScore) { gWorstScore = gScores[k]; gWorst = k; }
        }
    }
}

void main() {
    uvec3 cellIdx = gl_GlobalInvocationID;
    uvec3 gridDim = uvec3(uint(pc.gridExt.x), uint(pc.gridExt.y), uint(pc.gridExt.z));

    // Диспатч всегда кратен воркгруппе (64/8, 64/4, 64/8) — потоков вне сетки
    // не существует; ранний return здесь запрещён барьерами тайла.
    uint flatCellIndex = cellIdx.x + cellIdx.y * gridDim.x + cellIdx.z * (gridDim.x * gridDim.y);

    vec3 cellSize = vec3(pc.gridMin.w, pc.gridExt.w, pc.gridMin.w);
    vec3 cellMin = pc.gridMin.xyz + vec3(cellIdx) * cellSize;
    vec3 cellMax = cellMin + cellSize;

    uint activeCount = min(uPointLightCount, uint(pc.params.x));
    uint staticCount = min(pc.genStaticCount, activeCount);

    if (gl_LocalInvocationIndex == 0u) sGroupDirty = 0u;
    barrier();
    if (uDirtyGen[flatCellIndex] > pc.genBaked) atomicOr(sGroupDirty, 1u);
    barrier();
    bool groupDirty = sGroupDirty != 0u;

    // КАМЕРНЫЙ гейт грязноты (решение владельца 2026-08-21: «свет в дыру тем
    // же кадром» — закон для камеры). Далёкая грязная группа живёт по
    // stale-списку до свапа патча (~0.3 с) — её никто не видит, а фоллбэк по
    // всему тору превращал массовые разрушения в фриз. Порог pc.camPos.w =
    // 2×R_max (вывод в gpu_light_grid.h). Дистанция считается от бокса ВСЕЙ
    // воркгруппы (из gl_WorkGroupID — однородно): внутри грязного пути стоят
    // барьеры, ветка обязана быть group-uniform.
    if (groupDirty) {
        vec3 wgMin = pc.gridMin.xyz +
                     vec3(gl_WorkGroupID) * vec3(gl_WorkGroupSize) * cellSize;
        vec3 wgMax = wgMin + vec3(gl_WorkGroupSize) * cellSize;
        float dCam = dist_sq_point_aabb_toroidal(pc.camPos.xyz, wgMin, wgMax,
                                                 pc.params.y);
        if (dCam > pc.camPos.w * pc.camPos.w) groupDirty = false;
    }

    const uint tid = gl_LocalInvocationIndex;
    if (groupDirty && pc.params.w > 0.5) {
        // Грязная группа У КАМЕРЫ, топология залита — «все лампы радиуса»
        // через КЛАСТЕРНЫЕ БАКЕТЫ (инкремент 4): каждая лампа — член ровно
        // одного 8-м бакета, лампа достающая клетку лежит не дальше
        // R_max + полудиагоналей — скан соседних бакетов полон по построению,
        // инвариант (б) «посветить лишним» цел, всей таблицы больше нет.
        float cbM = pc.gridMin.w * 2.0;       // бакет = 2 клетки светосетки
        uint cbDim = uint(pc.gridExt.x) / 2u; // та же производная, что у CPU
        // R_max + полудиагональ бакета + полудиагональ клетки, в бакетах.
        int br = int(ceil((pc.params.z + 0.8660254 * (cbM + pc.gridMin.w)) / cbM));
        vec3 cc0 = (cellMin + cellMax) * 0.5;
        int cbx = int(floor(cc0.x / cbM));
        int cby = int(floor(cc0.y / cbM));
        int cbz = int(floor(cc0.z / cbM));
        for (int dz2 = -br; dz2 <= br; ++dz2)
            for (int dy2 = -br; dy2 <= br; ++dy2)
                for (int dx2 = -br; dx2 <= br; ++dx2) {
                    uint bx2 = uint(cbx + dx2) & (cbDim - 1u);
                    uint by2 = uint(cby + dy2) & (cbDim - 1u);
                    uint bz2 = uint(cbz + dz2) & (cbDim - 1u);
                    uint bi = (bx2 + by2 * cbDim + bz2 * cbDim * cbDim) * 2u;
                    uint mCount = uClusterBucketRange[bi + 1u];
                    if (mCount == 0u) continue;
                    uint mStart = uClusterBucketRange[bi];
                    for (uint mk = 0u; mk < mCount; ++mk) {
                        uint id = uClusterMembers[mStart + mk];
                        // Надгробие — не кандидат (как в полном скане).
                        if (uPointLights[id].colorIntensity.w <= kTombstone)
                            continue;
                        vec4 pr = uPointLights[id].posRadius;
                        float radius = pr.w;
                        float dSq = dist_sq_point_aabb_toroidal(
                            pr.xyz, cellMin, cellMax, pc.params.y);
                        if (dSq > radius * radius) continue;
                        consider(id, dSq / (radius * radius));
                    }
                }
    } else if (groupDirty) {
        // Топологии нет (этаж без кластерной паковки) — прежний полный
        // тайловый скан всей статик-таблицы. Ветка group-uniform: params —
        // пуш-константа.
        for (uint base = 0u; base < staticCount; base += 256u) {
            const uint n = min(staticCount - base, 256u);
            if (tid < n) {
                sTile[tid] = uPointLights[base + tid].posRadius;
                sTileW[tid] = uPointLights[base + tid].colorIntensity.w;
            }
            barrier();

            for (uint j = 0u; j < n; ++j) {
                // Надгробие (умершая лампа: intensity 0, слот жив до ребейка)
                // не кандидат — иначе оно занимало бы слот и жгло марш.
                if (sTileW[j] <= kTombstone) continue;
                vec4 pr = sTile[j];
                float radius = pr.w;
                float dSq = dist_sq_point_aabb_toroidal(pr.xyz, cellMin, cellMax, pc.params.y);
                if (dSq > radius * radius) continue;
                consider(base + j, dSq / (radius * radius));
            }
            barrier();
        }
    } else {
        // Чистая клетка: кандидаты — запечённый список (только В ПРИНЦИПЕ
        // достижимые лампы; вклад пересчитывается той же формулой — в бейке
        // лежат одни id). Тайловый цикл пропущен ЦЕЛИКОМ — это и есть выигрыш.
        uint n = min(uBakedCells[flatCellIndex].count, kCellSlots);
        for (uint k = 0u; k < n; ++k) {
            uint id = uBakedCells[flatCellIndex].lightIndices[k];
            if (id >= staticCount) continue; // таблица уехала — ждём свапа
            if (uPointLights[id].colorIntensity.w <= kTombstone) continue;
            vec4 pr = uPointLights[id].posRadius;
            float radius = pr.w;
            float dSq = dist_sq_point_aabb_toroidal(pr.xyz, cellMin, cellMax, pc.params.y);
            if (dSq > radius * radius) continue;
            consider(id, dSq / (radius * radius));
        }
    }

    // Динамический хвост (мобы-эмиттеры, снаряды, фонарик) — ЧЕРЕЗ БАКЕТЫ
    // (59.14): раньше каждая клетка сканировала весь хвост, и перестрелка
    // (каждый снаряд — лампа) дорожала линейно от интенсивности боя. Теперь
    // клетка читает свой бакет; перелив бакета честно падает на старый
    // полный скан — свет не теряется по построению.
    if (activeCount > staticCount) {
        vec3 cc = (cellMin + cellMax) * 0.5;
        float bucketM = pc.params.y / float(pc.dynBucketDim);
        uint mask = pc.dynBucketDim - 1u;
        uint bx = uint(floor(cc.x / bucketM)) & mask;
        uint by = uint(floor(cc.y / bucketM)) & mask;
        uint bz = uint(floor(cc.z / bucketM)) & mask;
        uint base = (bx + by * pc.dynBucketDim +
                     bz * pc.dynBucketDim * pc.dynBucketDim) *
                    (1u + pc.dynBucketSlots);
        uint cnt = uDynBuckets[base];
        if (cnt == kDynFallback) {
            for (uint i = staticCount; i < activeCount; ++i) {
                vec4 pr = uPointLights[i].posRadius;
                float radius = pr.w;
                // CPU add_light уже отверг radius<=0 и intensity<=0.001.
                float dSq = dist_sq_point_aabb_toroidal(pr.xyz, cellMin, cellMax, pc.params.y);
                if (dSq > radius * radius) continue;
                consider(i, dSq / (radius * radius));
            }
        } else {
            for (uint k = 0u; k < cnt; ++k) {
                uint i = uDynBuckets[base + 1u + k];
                vec4 pr = uPointLights[i].posRadius;
                float radius = pr.w;
                float dSq = dist_sq_point_aabb_toroidal(pr.xyz, cellMin, cellMax, pc.params.y);
                if (dSq > radius * radius) continue;
                consider(i, dSq / (radius * radius));
            }
        }
    }

    // Список клетки пишется ОТСОРТИРОВАННЫМ по вкладу (лучший — первым):
    // потребители тратят бюджет (теневые лучи, шаги дымки) на сильнейшие
    // источники и режут тусклый хвост стабильно, без мерцания состава.
    for (uint a = 1u; a < gFound; ++a) {
        float s = gScores[a];
        uint  v = gIndices[a];
        uint  b = a;
        for (; b > 0u && gScores[b - 1u] > s; --b) {
            gScores[b] = gScores[b - 1u];
            gIndices[b] = gIndices[b - 1u];
        }
        gScores[b] = s;
        gIndices[b] = v;
    }

    LightGridCell cell;
    cell.count = gFound;
    for (uint k = 0u; k < kCellSlots; ++k) {
        cell.lightIndices[k] = (k < gFound) ? gIndices[k] : 0u;
    }

    uGridCells[flatCellIndex] = cell;

    // Перелив — вслух: клетка видела больше достижимых ламп, чем слотов, и
    // хвост вытеснен по вкладу. Одно слово на клетку, читает CPU кадром позже.
    if (gCandidates > kCellSlots) {
        atomicAdd(uCellOverflow, 1u);
    }
}
