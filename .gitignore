# Build output
/build/
/build-win/
/out/

# CMake FetchContent caches live under build/, but guard the source tree too.
_deps/

# Compiled SPIR-V — build products, glslc writes them into build/shaders/.
# AGENTS.md: never stage shaders/** binaries; sources (.vert/.frag/.comp/.glsl) stay tracked.
shaders/*.spv

# ctest output written into the repo root when ctest runs from here.
/Testing/

# Agent scratch (briefings/progress/handoffs) — session-local, not project state.
.agents/

# Editor / OS cruft
.DS_Store
*.swp
compile_commands.json
.cache/

# ImGui runtime state
imgui.ini

# Screenshot proofs. `gigahrush2 --shot out.png` writes into the working
# directory, so every capture the debug tool exists to produce (render/
# screenshot.h) is a 2-4 MB file that `git add -A` would otherwise sweep in.
# Still safe as a blanket rule, but no longer because the engine is imageless:
# data/textures/ now carries 16 committed BC7/KTX2 albedo maps (see its README).
# Those are .ktx2, so this rule does not touch them — but it WOULD silently
# swallow a .png asset, so add a negation here before committing one.
# The fetch tool's download cache is already covered by `.cache/` above.
*.png
!assets/*.png
!docs/*.png


# Claude Code personal/local settings (not shared)
.claude/settings.local.json

# Agent worktrees. These are live git worktrees of THIS repository, so `git add -A`
# sees each one as an embedded repo and commits a gitlink that points nowhere for
# anybody else. Committed two by accident in 107b6fa; removed in the next commit.
.claude/worktrees/

# Python bytecode from the table generators.
tools/__pycache__/
__pycache__/

# Save games written next to the exe by F5 ([app/main.cpp] kSavePath).
*.sav

# Golden dumps written by the render-parity harness. A visual-parity check for
# cube_pass has to prove not a single pixel moved, which means dumping the cell-class
# and instance buffers before a change and diffing them after — 8 MB and 15 MB
# respectively, generated, with no reader in src/ or tests/. They are measurement
# output, not fixtures: regenerate them, never commit them. Named explicitly rather
# than as *.bin, because the nav-cache blobs are also .bin and that rule already has
# its own directory entry below.
/golden_cellclass.bin
/golden_instances.bin

# Scratch directory for the nav-cache round-trip tests (tests/game_test.cpp:3720, :3760).
# The tests std::remove their own files, and an EMPTY directory does not dirty git status,
# so this is insurance rather than a live fix: there is no remove_all, so a run that fails
# part-way leaves a .bin behind with nothing ignoring it.
navcache_test_tmp/
gigahrush2_save/
