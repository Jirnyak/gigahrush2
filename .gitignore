# Build output
/build/
/build-win/
/out/

# CMake FetchContent caches live under build/, but guard the source tree too.
_deps/

# Editor / OS cruft
.DS_Store
*.swp
compile_commands.json
.cache/

# ImGui runtime state
imgui.ini

# Screenshot proofs. `gigahrush2 --shot out.png` writes into the working
# directory, so every capture the debug tool exists to produce (render/
# screenshot.h) is a 2-4 MB file that `git add -A` would otherwise sweep in.
# Safe as a blanket rule: this engine has no image assets and no image decoder
# to read them with — surfaces are generated, not sampled (render.md).
*.png

# Claude Code personal/local settings (not shared)
.claude/settings.local.json

# Agent worktrees. These are live git worktrees of THIS repository, so `git add -A`
# sees each one as an embedded repo and commits a gitlink that points nowhere for
# anybody else. Committed two by accident in 107b6fa; removed in the next commit.
.claude/worktrees/
